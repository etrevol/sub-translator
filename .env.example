# Copy this file to .env and fill in your key.
# Only the gemini engine needs it — `--engine google` works without any key.

# Get one at https://aistudio.google.com/apikey  (no quotes, no spaces)
GEMINI_API_KEY=your_api_key_here

# Any model your key can access. `python subtrans.py doctor` lists them.
GEMINI_MODEL=gemini-3.5-flash-lite
